# Copy to .env. Never commit credentials. No live inference runs until explicitly selected.
HF_TOKEN=
# Exact chat-completions URL for a self-hosted server, if available.
HF_ENDPOINT=
# Model to request. Defaults to Qwen/Qwen3-30B-A3B; change it if the provider withdraws that model.
HF_MODEL=
# Confirm promo eligibility in HF dashboard, then set true. Required for HF-paid route.
HF_BILLING_CONFIRMED=false
# Enter the actual selected provider's USD / million token rates. Do not guess.
HF_INPUT_USD_PER_MILLION=
HF_OUTPUT_USD_PER_MILLION=
HF_DEV_BUDGET_USD=25
# Voice questions use a local open Whisper model. Needs: pip install faster-whisper "av<17"
ENABLE_WHISPER=false
# Compose only: generate distinct secrets via scripts/compose_setup.py.
SENDER_SECRET=
PROCESSOR_SECRET=
RECIPIENT_SECRET=
